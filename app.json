{
  "expo": {
    "name": "PokeBindr",
    "slug": "poketracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "pokebindr",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.achilyss.pokebindr"
    },
    "android": {
      "package": "com.achilyss.pokebindr",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c0a08"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to scan and identify your cards."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0c0a08"
        }
      ],
      "expo-secure-store",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f92141e-0151-47c3-981d-ac78231a972b"
      }
    },
    "owner": "achilyss-organization"
  }
}
